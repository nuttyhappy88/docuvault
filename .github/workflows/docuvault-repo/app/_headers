# Security headers for hosting the app on its own (Netlify reads this file).
# Not used when the office computer serves the app; it sends its own headers.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src 'self' https://*.floot.app; frame-src 'self' blob:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; object-src blob:; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
/config.js
  Cache-Control: no-cache
