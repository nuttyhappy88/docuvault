{
  "name": "docuvault-desktop",
  "productName": "DocuVault",
  "version": "3.0.0",
  "description": "DocuVault for Windows: the full DocuVault app as a desktop program, working offline and syncing with your DocuVault server.",
  "author": "DocuVault",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "ph.docuvault.desktop",
    "productName": "DocuVault",
    "files": ["main.js", "web/**"],
    "directories": { "output": "dist" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "web/icons/icon-512.png",
      "artifactName": "DocuVault-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DocuVault",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
